---
import Layout from '../layouts/Layout.astro';

const artworks = [
  { slug: 'battle-of-mactan',  title: 'Battle of Mactan',                        artist: 'Elmer Borlongan',   image: '/artworks/battle-of-mactan.jpg' },
  { slug: 'general-malvar',    title: 'General Malvar: Lider ng Masang Pilipino', artist: 'Juanito Torres',    image: '/artworks/general-malvar.jpg' },
  { slug: 'achilles-patroclus',title: 'Achilles Lamenting the Death of Patroclus',artist: 'Gavin Hamilton',   image: '/artworks/achilles-patroclus.jpg' },
  { slug: 'spoliarium',        title: 'Spoliarium',                               artist: 'Juan Luna',         image: '/artworks/spoliarium.jpg' },
  { slug: 'diwata',            title: 'Diwata',                                   artist: 'Guillermo Tolentino',image: '/artworks/diwata.jpg' },
];
---

<Layout title="Culture & Identity | A Virtual Museum Tour">
  <main>

    <!-- ═══════════════════════════════════════════
         HERO — Ken Burns effect
    ═══════════════════════════════════════════ -->
    <section class="hero">
      <div class="hero-img-wrap">
        <img src="/hero-image.jpg" alt="Museum gallery" class="hero-img ken-burns" />
      </div>
      <div class="hero-overlay"></div>
      <div class="hero-fade-bottom"></div>

      <div class="hero-content">
        <p class="hero-eyebrow">A Virtual Museum Tour</p>
        <h1 class="hero-title">Culture &amp;<br/>Identity</h1>
        <p class="hero-sub">
          Exploring Filipino cultural heritage and national identity<br/>
          through seven defining works of art.
        </p>
        <a href="/artworks" class="btn-primary">Enter the Collection</a>
      </div>

      <div class="scroll-indicator">
        <span class="scroll-label">Scroll</span>
        <div class="scroll-line"></div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         INTRO
    ═══════════════════════════════════════════ -->
    <section class="intro">
      <p class="section-eyebrow reveal">The Exhibition</p>
      <h2 class="intro-title reveal reveal-delay-1">Art as a Mirror of a Nation</h2>
      <div class="divider-line reveal reveal-delay-2"></div>
      <p class="intro-body reveal reveal-delay-3">
        From the fierce resistance at Mactan to the triumphant canvases of Madrid,
        these works trace the long arc of Filipino identity — shaped by struggle,
        faith, artistry, and an enduring sense of nationhood.
      </p>
    </section>

    <!-- Thin rule -->
    <div class="section-rule"></div>

    <!-- ═══════════════════════════════════════════
         COLLECTION GRID
    ═══════════════════════════════════════════ -->
    <section class="collection-section">
      <div class="collection-header reveal">
        <h2 class="collection-title">The Collection</h2>
        <a href="/artworks" class="view-all-link">View All →</a>
      </div>

      <!-- Row 1: 3 columns -->
      <div class="grid-3">
        {artworks.slice(0,3).map((work, i) => (
          <a
            href={`/artworks/${work.slug}`}
            class={`artwork-card reveal reveal-delay-${i+1}`}
          >
            <img src={work.image} alt={work.title} class="artwork-img" />
            <div class="card-gradient"></div>
            <div class="card-info">
              <p class="card-artist">{work.artist}</p>
              <h3 class="card-title">{work.title}</h3>
            </div>
          </a>
        ))}
      </div>

      <!-- Row 2: 2 wide -->
      <div class="grid-2">
        {artworks.slice(3,5).map((work, i) => (
          <a
            href={`/artworks/${work.slug}`}
            class={`artwork-card reveal reveal-delay-${i+1}`}
          >
            <img src={work.image} alt={work.title} class="artwork-img" />
            <div class="card-gradient"></div>
            <div class="card-info">
              <p class="card-artist">{work.artist}</p>
              <h3 class="card-title">{work.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════
         ACCENT — Meet the Artists
    ═══════════════════════════════════════════ -->
    <section class="accent-section">
      <p class="accent-eyebrow reveal">Meet the Artists</p>
      <h2 class="accent-title reveal reveal-delay-1">The Hands Behind the Work</h2>
      <div class="divider-line divider-accent reveal reveal-delay-2"></div>
      <p class="accent-body reveal reveal-delay-3">
        Five artists across centuries, nationalities, and disciplines —
        united by the power of art to capture the human experience.
      </p>
      <a href="/artists" class="btn-light reveal reveal-delay-4">View Artists</a>
    </section>

  </main>
</Layout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    height: 100vh;
    overflow: hidden;
  }
  .hero-img-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .hero-img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: center;
    transform-origin: center center;
  }
  .hero-overlay {
    position: absolute; inset: 0;
    background: rgba(242,234,216,0.38);
  }
  .hero-fade-bottom {
    position: absolute; bottom: 0; left: 0; right: 0;
    height: 220px;
    background: linear-gradient(to bottom, transparent, #f2ead8);
  }
  .hero-content {
    position: absolute; inset: 0;
    display: flex; flex-direction: column;
    justify-content: center; align-items: center;
    text-align: center; padding: 2rem;
  }
  .hero-eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: #1c1917;
    opacity: 0.5;
    margin-bottom: 1.5rem;
    animation: fadeUp 1s ease 0.3s both;
  }
  .hero-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(3.5rem, 9vw, 9rem);
    font-weight: 700;
    color: #1c1917;
    line-height: 0.95;
    margin-bottom: 2rem;
    animation: fadeUp 1s ease 0.5s both;
  }
  .hero-sub {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: #1c1917;
    opacity: 0.6;
    max-width: 460px;
    line-height: 1.75;
    margin-bottom: 3rem;
    font-weight: 300;
    animation: fadeUp 1s ease 0.7s both;
  }
  .btn-primary {
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #f2ead8;
    background: #1c1917;
    padding: 1rem 2.5rem;
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease;
    animation: fadeUp 1s ease 0.9s both;
  }
  .btn-primary:hover {
    background: #8b1a1a;
  }
  .scroll-indicator {
    position: absolute; bottom: 2.5rem; left: 50%;
    transform: translateX(-50%);
    display: flex; flex-direction: column;
    align-items: center; gap: 0.5rem;
    animation: fadeUp 1s ease 1.2s both;
  }
  .scroll-label {
    font-family: 'Inter', sans-serif;
    font-size: 0.6rem; letter-spacing: 0.35em;
    text-transform: uppercase; color: #1c1917; opacity: 0.4;
  }
  .scroll-line {
    width: 1px; height: 44px;
    background: #1c1917; opacity: 0.2;
  }

  /* ── Intro ── */
  .intro {
    max-width: 760px;
    margin: 0 auto;
    padding: 8rem 4rem;
    text-align: center;
    background: var(--bg); /* ADD THIS */
  }
  .section-eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 0.62rem;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    opacity: 0.4;
    margin-bottom: 1.5rem;
    display: block;
  }
  .intro-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400;
    font-style: italic;
    line-height: 1.15;
    margin-bottom: 1.75rem;
  }
  .divider-line {
    width: 36px; height: 2px;
    background: #8b1a1a;
    margin: 0 auto 2rem;
  }
  .intro-body {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem;
    line-height: 1.95;
    opacity: 0.7;
    font-weight: 300;
  }

  /* ── Section rule ── */
  .section-rule {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 4rem;
    border-top: 1px solid rgba(28,25,23,0.1);
    background: var(--bg); /* ADD THIS */
  }

  /* ── Collection ── */
  .collection-section {
    padding: 6rem 4rem;
    max-width: 1200px;
    margin: 0 auto;
    background: var(--bg); /* ADD THIS */
  }
  .collection-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2.5rem;
  }
  .collection-title {
    font-family: 'Playfair Display', serif;
    font-size: 2rem; font-weight: 400;
  }
  .view-all-link {
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem; letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #8b1a1a; text-decoration: none; opacity: 0.8;
    transition: opacity 0.2s ease;
  }
  .view-all-link:hover { opacity: 1; }

  .grid-3 {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 3px;
  }
  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    margin-top: 3px;
  }

  .artwork-card {
    position: relative;
    overflow: hidden;
    display: block;
    text-decoration: none;
    color: #1c1917;
    background: #ddd4c0;
  }
  .grid-3 .artwork-card { aspect-ratio: 4/5; }
  .grid-2 .artwork-card { aspect-ratio: 16/7; }

  .artwork-img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 0.9s ease, filter 0.5s ease;
    display: block;
  }
  .card-gradient {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(28,25,23,0.88) 0%, transparent 52%);
  }
  .card-info {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: 1.75rem;
  }
  .card-artist {
    font-family: 'Inter', sans-serif;
    font-size: 0.6rem; letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #f2ead8; opacity: 0.6; margin-bottom: 0.35rem;
  }
  .card-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.05rem; font-weight: 500;
    color: #f2ead8; line-height: 1.25;
  }

  /* ── Accent section ── */
  .accent-section {
    background: #1c1917;
    padding: 8rem 4rem;
    text-align: center;
  }
  .accent-eyebrow {
    font-family: 'Inter', sans-serif;
    font-size: 0.62rem; letter-spacing: 0.45em;
    text-transform: uppercase;
    color: #f2ead8; opacity: 0.4;
    margin-bottom: 1.5rem; display: block;
  }
  .accent-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 400; font-style: italic;
    color: #f2ead8; margin-bottom: 1.75rem;
  }
  .divider-accent { background: #8b1a1a; }
  .accent-body {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.15rem; line-height: 1.9;
    color: #f2ead8; opacity: 0.6; font-weight: 300;
    max-width: 520px; margin: 0 auto 3rem;
  }
  .btn-light {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 0.7rem; letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #1c1917; background: #f2ead8;
    padding: 1rem 2.5rem; text-decoration: none;
    transition: background 0.25s ease;
  }
  .btn-light:hover { background: #fff; }

  /* ── Fade-up keyframe ── */
  @keyframes fadeUp {
    from { opacity:0; transform:translateY(20px); }
    to   { opacity:1; transform:translateY(0); }
  }
  @media (max-width: 640px) {
  .grid-3, .grid-2 {
    grid-template-columns: 1fr;
  }
  .grid-3 .artwork-card { aspect-ratio: 4/3; }
  .grid-2 .artwork-card { aspect-ratio: 4/3; }
  .collection-section { padding: 3rem 1.25rem; }
}
</style>